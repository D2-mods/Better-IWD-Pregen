/*
inlined files:
COPY - ~.../temp/blocks~  ~inlined/blunt.BAF~
COPY - ~.../temp/blocks~  ~inlined/warrior.BAF~
COPY - ~.../temp/blocks~  ~inlined/thief.BAF~
COPY - ~.../temp/blocks~  ~inlined/ranged.BAF~
*/


//blunt
<<<<<<<< .../temp/blocks
IF
	!Global("d2Player1blunt","GLOBAL",1)
//	GlobalTimerNotExpired("d2Player1equip","GLOBAL")
	Exists(Player1)
	OR(2)
		NumItemsGT("%staff%",Player1,0)
		CheckPartyAverageLevel(3,LESS_THAN)
	!PartyHasItem("%flameoil%")
	!PartyHasItem("%elfwine%")
THEN
	RESPONSE #100
		GiveItemCreate("%flail%",%target%,0,0,0)    // flail
		SetGlobal("d2Player1blunt","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%mace%",%target%,0,0,0)    // mace
		SetGlobal("d2Player1blunt","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%morningstar%",%target%,0,0,0)    // morning star
		SetGlobal("d2Player1blunt","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%club%",%target%,0,0,0)    // club
		SetGlobal("d2Player1blunt","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%hammer%",%target%,0,0,0)    // hammer
		SetGlobal("d2Player1blunt","GLOBAL",1)
		Continue()
END
>>>>>>>>

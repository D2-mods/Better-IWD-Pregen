//ranged
<<<<<<<< .../temp/blocks
IF
	!Global("d2Player1ranged","GLOBAL",1)
//	GlobalTimerNotExpired("d2Player1equip","GLOBAL")
	Exists(Player1)
	OR(2)
		NumItemsGT("%staff%",Player1,0)
		CheckPartyAverageLevel(3,LESS_THAN)
	!PartyHasItem("%flameoil%")
	!PartyHasItem("%elfwine%")
THEN
	RESPONSE #100
		GiveItemCreate("%shortbow%",%target%,0,0,0)    // shortbow
		GiveItemCreate("%arrow%",%target%,40,0,0)
		SetGlobal("d2Player1ranged","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%lightcrossbow%",%target%,0,0,0)    // crossbow
		GiveItemCreate("%bolt%",%target%,40,0,0)
		SetGlobal("d2Player1ranged","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%sling%",%target%,0,0,0)    // sling
		GiveItemCreate("%bullet%",%target%,40,0,0)
		SetGlobal("d2Player1ranged","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%throwingdagger%",%target%,10,0,0)    // throwing dagger
		SetGlobal("d2Player1ranged","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%longbow%",%target%,0,0,0)    // longbow
		GiveItemCreate("%arrow%",%target%,40,0,0)
		SetGlobal("d2Player1ranged","GLOBAL",1)
		Continue()
END
>>>>>>>>
COPY - ~.../temp/blocks~  ~inlined/ranged.BAF~



/*
extra checks (less janky if run from area script)
*/

//always give a large sword
<<<<<<<< .../temp/blocks
IF
	!Global("d2ngswordcheck","GLOBAL",1)
	GlobalTimerExpired("d2Player1equip","GLOBAL")
	Global("d2ngitemsplayer1","GLOBAL",1)
	NumItemsGT("%staff%",Player1,0)
	!PartyHasItem("%longsword%")
	!PartyHasItem("%scimitar%")
THEN
	RESPONSE #100
		GiveItemCreate("%longsword%",Player1,0,0,0)    // long sword
		SetGlobal("d2ngswordcheck","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%scimitar%",Player1,0,0,0)    // scimitar
		SetGlobal("d2ngswordcheck","GLOBAL",1)
		Continue()
END

IF
	!Global("d2ngswordcheck","GLOBAL",1)
	OR(2)
		PartyHasItem("%longsword%")
		PartyHasItem("%scimitar%")
THEN
	RESPONSE #100
		SetGlobal("d2ngswordcheck","GLOBAL",1)
		Continue()
END
>>>>>>>>
COPY - ~.../temp/blocks~  ~inlined/swordcheck.BAF~
  EVALUATE_BUFFER


//always give a bow or crossbow (if 2+ PCs)
<<<<<<<< .../temp/blocks
IF
	!Global("d2ngbowcheck","GLOBAL",1)
	GlobalTimerExpired("d2Player2equip","GLOBAL")
	Global("d2ngitemsplayer2","GLOBAL",1)
	NumItemsGT("%staff%",Player2,0)
	!PartyHasItem("%shortbow%")
	!PartyHasItem("%lightcrossbow%")
	!PartyHasItem("%longbow%")
THEN
	RESPONSE #100
		GiveItemCreate("%shortbow%",Player2,0,0,0)    // shortbow
		GiveItemCreate("%arrow%",Player2,40,0,0)
		SetGlobal("d2ngbowcheck","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%lightcrossbow%",Player2,0,0,0)    // crossbow
		GiveItemCreate("%bolt%",Player2,40,0,0)
		SetGlobal("d2ngbowcheck","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%longbow%",Player2,0,0,0)    // longbow
		GiveItemCreate("%arrow%",Player2,40,0,0)
		SetGlobal("d2ngbowcheck","GLOBAL",1)
		Continue()
END

IF
	!Global("d2ngbowcheck","GLOBAL",1)
	OR(3)
		PartyHasItem("%shortbow%")
		PartyHasItem("%lightcrossbow%")
		PartyHasItem("%longbow%")
THEN
	RESPONSE #100
		SetGlobal("d2ngbowcheck","GLOBAL",1)
		Continue()
END
>>>>>>>>

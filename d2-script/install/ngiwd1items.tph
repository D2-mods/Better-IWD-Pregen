//always give a flail or morning star (if 4+ PCs)
<<<<<<<< .../temp/blocks
IF
	!Global("d2ngflailcheck","GLOBAL",1)
	GlobalTimerExpired("d2Player4equip","GLOBAL")
	Global("d2ngitemsplayer4","GLOBAL",1)
	NumItemsGT("%staff%",Player4,0)
	!PartyHasItem("%flail%")
	!PartyHasItem("%morningstar%")
THEN
	RESPONSE #100
		GiveItemCreate("%flail%",Player1,0,0,0)    // flail
		SetGlobal("d2ngflailcheck","GLOBAL",1)
		Continue()
	RESPONSE #100
		GiveItemCreate("%morningstar%",Player1,0,0,0)    // morning star
		SetGlobal("d2ngflailcheck","GLOBAL",1)
		Continue()
END

IF
	!Global("d2ngflailcheck","GLOBAL",1)
	OR(2)
		PartyHasItem("%flail%")
		PartyHasItem("%morningstar%")
THEN
	RESPONSE #100
		SetGlobal("d2ngflailcheck","GLOBAL",1)
		Continue()
END

//sound effect (not used, better with no sound)
ACTION_IF !(FILE_EXISTS_IN_GAME ~GAM_11.wav~) BEGIN
  COPY ~%files%/GAM_11.wav~  ~override~
END
OUTER_SPRINT ngsound  ~PlaySound("GAM_11")~

//edit for IWD1(EE)
DEFINE_PATCH_FUNCTION d2ngitemsdelay BEGIN
  REPLACE_TEXTUALLY ~d2Player1equip~  ~d2ngitemsdelay~
  SPRINT match  ~GLOBAL")~
  SPRINT string  ~!GlobalTimerNotExpired("d2Player1equip","GLOBAL")~
  REPLACE_TEXTUALLY ~%match%~  ~%match% %string%~
END

//tutu: workaround for journal entry not being visible
ACTION_IF (GAME_IS ~tutu tutu_totsc~) BEGIN
  OUTER_SPRINT temp  ~SetGlobal("Chapter","GLOBAL",1)~
  OUTER_SPRINT done  ~SetGlobal("Chapter","GLOBAL",0)~
  OUTER_SPRINT ngequipjour  ~%temp% %ngequipjour% %done%~
  OUTER_SPRINT ngequipsolo  ~%temp% %ngequipsolo% %done%~
END



COPY - ~.../temp/script~  ~inlined/string.BAF~
  EVALUATE_BUFFER
  PATCH_IF (ngstartmode = 2) BEGIN
    REPLACE_TEXTUALLY ~1012~ ~1011~
    REPLACE_TEXTUALLY ~1013~ ~1011~
  END
  PATCH_IF (GAME_IS ~iwd how totlm~) BEGIN
    REPLACE_TEXTUALLY ~!PartyHasItem~  ~False()//~
  END
  LPF d2ngitemsdelay END


//IWDEE: message needs to play even if scripting was paused (no longer needed, but no reason to change this part)
//this is now used for all games, only gives journal entry in starting areas
<<<<<<<< .../temp/script
IF
	!Global("d2ngequipdial","GLOBAL",1)
	!GlobalTimerNotExpired("d2ngitemsdelay","GLOBAL")
THEN
	RESPONSE #100
		SetGlobalTimer("d2ngitemsdelay","GLOBAL",4)
		SetGlobal("d2ngequipdial","GLOBAL",1)
		Continue()
END

//IWD1 - autoequip hammer is hq version
ACTION_IF (FILE_EXISTS_IN_GAME ~hqhamm.itm~) BEGIN
  OUTER_SPRINT hammer  ~hqhamm~
END


//ammo stacks
OUTER_SET 1slots = 20    // for bag option
OUTER_SET 2slots = 40
OUTER_SET 3slots = 40
OUTER_SET 4slots = 60
OUTER_SET 5slots = 60
OUTER_SET 6slots = 80
OUTER_SET taxes = 5    // item stacks (these are used by both installer options)
OUTER_SET tdags = 10
OUTER_SET thams = 5
OUTER_SET tjavs = 5
OUTER_SET toils = 2
OUTER_SET twins = 2
OUTER_SET tstar = 30

ACTION_DEFINE_ASSOCIATIVE_ARRAY d2ngthrowstacks BEGIN
  ~%throwingaxe%~     => ~%taxes%~
  ~%throwingdagger%~  => ~%tdags%~
  ~%throwinghammer%~  => ~%thams%~    // thrown hammers
  ~%throwingspear%~   => ~%tjavs%~    // project javelin
  ~%throwingoil%~     => ~%toils%~
  ~%throwingwine%~    => ~%twins%~
  ~%throwingstar%~    => ~%tstar%~    // ZS_ItemPack
END

//min STR checks (run after all array updates)
INCLUDE ~%install%/weapontypereqs.tph~



//
//add Worn Garment
OUTER_SPRINT startrobe  ~d2ngrobe~
OUTER_SPRINT copy  ~startrobe~
ACTION_IF (GAME_IS ~iwd2~) BEGIN  OUTER_SPRINT copy  ~startrobeiwd2~  END

//desc image for bg games
OUTER_SPRINT descimage  ~CCLCK06~
ACTION_IF (FILE_EXISTS_IN_GAME ~CCLCK09.bam~) BEGIN  OUTER_SPRINT descimage  ~CCLCK09~  END

OUTER_SPRINT desc  @712
ACTION_IF (ee_game > 0) BEGIN  OUTER_SPRINT desc  @711  END
ACTION_IF (GAME_IS ~iwd2~) BEGIN  OUTER_SPRINT desc  @713  END

COPY ~%ngequip%/startrobe.bam~  ~override/%startrobe%.bam~
COPY ~%ngequip%/%copy%.itm~  ~override/%startrobe%.itm~
  SAY NAME1 @710 SAY UNIDENTIFIED_DESC ~%desc%~
  SAY NAME2 @710
  WRITE_ASCII 0x3a ~%startrobe%~ #8    // bam icon
  PATCH_IF (GAME_IS ~bgee eet bgt tutu tutu_totsc ca~) BEGIN
    WRITE_ASCII 0x58 ~%descimage%~ #8
  END
  WRITE_LONG 0x34 3    // gold cost

//old resources for backwards compat
COPY ~override/%startrobe%.itm~  ~override/d2#ngrb0.itm~
COPY ~override/%startrobe%.itm~  ~override/d2#ngrb2.itm~

//bg1 - friendly arm
COPY_EXISTING ~FRIEND.STO~  ~override~
  LPF ADD_STORE_ITEM_EX INT_VAR unlimited=1 STR_VAR item_name=~%startrobe%~ position=~AFTER book55~ flags=~identified~ END
IF_EXISTS BUT_ONLY

//iwd1 - gerth's store
COPY_EXISTING ~KUGERTH.STO~  ~override~
  LPF ADD_STORE_ITEM_EX INT_VAR unlimited=1 STR_VAR item_name=~%startrobe%~ position=~AFTER ring11~ flags=~identified~ END
IF_EXISTS BUT_ONLY

//iwd2 - trading depot
COPY_EXISTING ~11DEIRD.STO~  ~override~
  LPF ADD_STORE_ITEM_EX INT_VAR unlimited=1 STR_VAR item_name=~%startrobe%~ position=~AFTER 00GBAG01~ flags=~identified~ END
IF_EXISTS BUT_ONLY



//
//log or journal entry
OUTER_SPRINT gotitems  ~~
OUTER_SPRINT ngequipjour  ~~
OUTER_SPRINT ngequipsolo  ~~

ACTION_IF (ee_game > 0) BEGIN
  LAF d2_color_string INT_VAR stringref=RESOLVE_STR_REF (@1011) STR_VAR color=blue RET newstring END
  OUTER_SPRINT gotitems ~DisplayString(Myself,%newstring%)~

  ACTION_IF (GAME_IS ~iwdee~) BEGIN
    ADD_JOURNAL @1014 @1015    // EE popup
    OUTER_SPRINT ngequipjour  ~AddJournalEntry(@1014,INFO)~
    OUTER_SPRINT ngequipsolo  ~AddJournalEntry(@1015,INFO)~
  END ELSE BEGIN
    ADD_JOURNAL @1016 @1017    // EE popup
    OUTER_SPRINT ngequipjour  ~AddJournalEntry(@1016,INFO)~
    OUTER_SPRINT ngequipsolo  ~AddJournalEntry(@1017,INFO)~
  END
END ELSE
ACTION_IF (GAME_IS ~iwd how totlm~) BEGIN
  OUTER_SPRINT  ngequipjour ~AddJournalEntry(@1014)~
  OUTER_SPRINT  ngequipsolo ~AddJournalEntry(@1015)~
  OUTER_SPRINT gotitems ~TomsStringDisplayer(@1011)~
END ELSE
ACTION_IF (GAME_IS ~iwd2~) BEGIN
  OUTER_SPRINT  ngequipjour ~AddJournalEntry(@1014)~
  OUTER_SPRINT  ngequipsolo ~AddJournalEntry(@1015)~
  OUTER_SPRINT gotitems ~DisplayMessage(@1012)~
END ELSE
ACTION_IF (GAME_IS ~iwd_in_bg2~) BEGIN
  OUTER_SPRINT  ngequipjour ~AddJournalEntry(@1014,INFO)~
  OUTER_SPRINT  ngequipsolo ~AddJournalEntry(@1015,INFO)~
  OUTER_SPRINT gotitems ~DisplayString(Myself,@1013)~
END ELSE BEGIN
  OUTER_SPRINT  ngequipjour ~AddJournalEntry(@1016,INFO)~
  OUTER_SPRINT  ngequipsolo ~AddJournalEntry(@1017,INFO)~
  OUTER_SPRINT gotitems ~DisplayString(Myself,@1012)~
//  ACTION_IF (GAME_IS ~ca~) BEGIN  OUTER_SPRINT gotitems ~DisplayString(Myself,@1013)~  END
END



>>>>>>>>
COPY - ~.../temp/script~  ~inlined/2elfwines.BAF~
  EVALUATE_BUFFER

DEFINE_ACTION_FUNCTION 2flamingoils BEGIN
  OUTER_SET oilcheck = 0
  OUTER_SET winecheck = 0
  ACTION_IF (FILE_EXISTS_IN_GAME ~%flameoil%.itm~) BEGIN  OUTER_SET oilcheck = 1  END
  ACTION_IF (FILE_EXISTS_IN_GAME ~%elfwine%.itm~) BEGIN  OUTER_SET winecheck = 1  END

  // iwd1 (duplicate items if in both area and global scripts)
  ACTION_IF (GAME_IS ~iwd how totlm~) BEGIN
    ACTION_IF oilcheck BEGIN  EXTEND_BOTTOM ~ar1006.BCS~ ~inlined/2flamingoils.BAF~  END
    ACTION_IF winecheck BEGIN  EXTEND_BOTTOM ~ar1006.BCS~ ~inlined/2elfwines.BAF~  END
  END
  ELSE BEGIN

  // add to scripts
  ACTION_FOR_EACH script IN
    ~ar1000~ ~ar1006~ ~TC0009~ ~baldur~
    ~ar2600~ ~bg2600~ ~AR0015~ ~_AR2600~
  BEGIN
    ACTION_IF (RESOURCE_CONTAINS ~%script%.bcs~  ~d2ng~) BEGIN
      ACTION_IF oilcheck BEGIN  EXTEND_BOTTOM ~%script%.BCS~ ~inlined/2flamingoils.BAF~  END
      ACTION_IF winecheck BEGIN  EXTEND_BOTTOM ~%script%.BCS~ ~inlined/2elfwines.BAF~  END
    END
  END

  END
END



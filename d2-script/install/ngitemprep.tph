  SPRINT katana ~%DEST_RES%~
  SPRINT $d2_weapontype_res (~katana~) ~%DEST_RES%~
IF_EXISTS

//iwd_in_bg2 edit (2haxe is buggy)
ACTION_IF (GAME_IS ~iwd_in_bg2~) BEGIN
  COPY_EXISTING ~2haxe.itm~  ~override/d22haxe.itm~
    SPRINT $d2_weapontype_res (~greataxe~) ~%DEST_RES%~
END

//cd javelin mod

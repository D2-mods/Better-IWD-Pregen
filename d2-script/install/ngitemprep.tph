//
//make ngitems array + set variables
ACTION_PHP_EACH d2_weapontype_res AS type => res BEGIN
  ACTION_IF (FILE_EXISTS_IN_GAME ~%res%.itm~) BEGIN
    ACTION_IF !(~%type%~ STRING_CONTAINS_REGEXP ~bolt~) BEGIN  OUTER_SPRINT $d2ngitemtypes (~%res%~) ~ammo~ END ELSE
    ACTION_IF !(~%type%~ STRING_CONTAINS_REGEXP ~arrow~) BEGIN  OUTER_SPRINT $d2ngitemtypes (~%res%~) ~ammo~ END ELSE
    ACTION_IF !(~%type%~ STRING_CONTAINS_REGEXP ~bullet~) BEGIN  OUTER_SPRINT $d2ngitemtypes (~%res%~) ~ammo~ END ELSE
    ACTION_IF !(~%type%~ STRING_CONTAINS_REGEXP ~dart~) BEGIN  OUTER_SPRINT $d2ngitemtypes (~%res%~) ~ammo~ END ELSE
    ACTION_IF !(~%type%~ STRING_CONTAINS_REGEXP ~throw~) BEGIN  OUTER_SPRINT $d2ngitemtypes (~%res%~) ~throwing~ END ELSE
    ACTION_IF (~%type%~ STRING_CONTAINS_REGEXP ~staff~) BEGIN  OUTER_SPRINT $d2ngitemtypes (~%res%~) ~weapon~ END    // skip staff
  END
  OUTER_SPRINT  ~%type%~ ~%res%~    // set variable to use individually if needed
END


  OUTER_SPRINT $d2_weapontype_res (~throwingspear~) ~cdjav0~
END

//rr composite shortbows
ACTION_IF (FILE_EXISTS_IN_GAME ~RR#BOW02.itm~) BEGIN
  OUTER_SPRINT $d2_weapontype_res (~rrshortbow~) ~RR#BOW02~
END

//zs shurikens
ACTION_IF (FILE_EXISTS_IN_GAME ~ZSIPSHU0.itm~) BEGIN
  OUTER_SPRINT $d2_weapontype_res (~throwingstar~) ~ZSIPSHU0~
END


//cheaper flaming oil
COPY_EXISTING ~FLAMOIL.ITM~  ~override/d2ngflam.itm~
              ~00MISC32.ITM~  ~override/d2ngflam.itm~
  WRITE_LONG 0x34 4
  LPF ALTER_EFFECT INT_VAR silent=1 STR_VAR match_resource=~%SOURCE_RES%~ resource=~%DEST_RES%~ END
  SPRINT $d2_weapontype_res (~throwingoil~) ~%DEST_RES%~
  SPRINT flameoil  ~%DEST_RES%~
IF_EXISTS

//cheaper elven healing wine
COPY_EXISTING ~elfwine.ITM~  ~override/d2ngwine.itm~
              ~00POTN06.ITM~  ~override/d2ngwine.itm~
  WRITE_LONG 0x34 4
  LPF ALTER_EFFECT INT_VAR silent=1 STR_VAR match_resource=~%SOURCE_RES%~ resource=~%DEST_RES%~ END
  SPRINT $d2_weapontype_res (~throwingwine~) ~%DEST_RES%~    // arbitrary name for array (you don't actually throw this)
  SPRINT elfwine  ~%DEST_RES%~
IF_EXISTS


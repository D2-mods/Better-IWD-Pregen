IF
	Global("d2scrp_mode","LOCALS",2)
    InParty(Myself)
    PartyScriptsActive()
    ActionListEmpty()
    HPPercentLT([PC],0)
    HaveSpell(CLERIC_RAISE_DEAD)  // SPPR502.SPL (Raise Dead)
THEN
    RESPONSE #100
        Spell(MostDamagedOf(Myself),CLERIC_RAISE_DEAD)  // SPPR502.SPL (Raise Dead)
END

IF
	Global("d2scrp_mode","LOCALS",2)
    InParty(Myself)
    PartyScriptsActive()
    ActionListEmpty()
    Heard(Player1,YAY)
    Range(Player1,6)
THEN
    RESPONSE #100
        Attack(LastAttackerOf(LastHeardBy))
END
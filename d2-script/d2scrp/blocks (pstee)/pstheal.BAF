IF
	Global("d2scrp_mode","LOCALS",2)
    InParty(Myself)
    PartyScriptsActive()
    ActionListEmpty()
    AttackedBy([ENEMY],DEFAULT)
THEN
    RESPONSE #100
        Attack(LastAttackerOf(Myself))
END

IF
	Global("d2scrp_mode","LOCALS",2)
    InParty(Myself)
    PartyScriptsActive()
    ActionListEmpty()
    HPPercentLT(MostDamagedOf(Myself),90)
    HaveSpell(CLERIC_AID)  // SPPR201.SPL (Aid)
THEN
    RESPONSE #100
        Spell(MostDamagedOf(Myself),CLERIC_AID)  // SPPR201.SPL (Aid)
END

